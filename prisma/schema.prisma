generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Oficinas ────────────────────────────────────────────────────────────────
//
// Cada oficina é um mundo à parte: toda tabela de dados carrega `oficinaId`, e nada
// que pertence a uma aparece para outra. São três travas independentes, de propósito:
//
//   1. Código  — as rotas só recebem um acesso ao banco já filtrado pela oficina de
//                quem está logado (`lib/db-oficina.ts`). O cliente Prisma cru fica
//                restrito a login, cadastro e plataforma.
//   2. Vínculo — gatilhos no banco recusam ligar registros de oficinas diferentes
//                (uma OS da oficina A apontando para um cliente da B).
//   3. Linha   — RLS do Postgres: a conexão da oficina só enxerga as linhas dela,
//                mesmo que o código esqueça um filtro.
//
// O `@default(dbgenerated(...))` de cada `oficinaId` lê a oficina da transação
// (`app.oficina_id`, definida pela trava 1). É o que marca até as gravações aninhadas
// — os itens criados junto com a OS — sem o código precisar lembrar.
model Oficina {
  id        String   @id @default(cuid())
  nome      String
  /// Suspensa pelo dono da plataforma: ninguém dela consegue entrar.
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Plano. A situação (teste, assinante, só leitura) não é guardada: sai destas datas a
  // cada requisição (`lib/plano.ts`), então vencer o prazo não depende de job nenhum.
  // As duas nulas = liberada sem prazo (oficinas antigas, convites, cortesia).
  /// Fim do teste grátis. Só existe em oficina criada pelo cadastro público (`/teste`).
  testeAte            DateTime?
  /// Pago até — estendido pelo webhook de pagamento.
  pagoAte             DateTime?
  /// Contato de quem se cadastrou pelo link público.
  whatsapp            String?
  /// De onde veio o cadastro (`?origem=` do link — ex.: "instagram").
  origem              String?
  /// Ids no gateway de pagamento (AbacatePay).
  gatewayClienteId    String?
  gatewayAssinaturaId String?

  configuracao       Configuracao?
  usuarios           Usuario[]
  clientes           Cliente[]
  veiculos           Veiculo[]
  ordens             OrdemServico[]
  mecanicos          Mecanico[]
  metas              Meta[]
  orcamentos         Orcamento[]
  itensOrcamento     ItemOrcamento[]
  itensOrdem         ItemOrdem[]
  produtos           Produto[]
  movimentosEstoque  MovimentoEstoque[]
  pagamentosOS       PagamentoOS[]
  dividasAvulsas     DividaAvulsa[]
  pagamentosDivida   PagamentoDivida[]
  fotos              FotoOS[]
  sequencias         Sequencia[]
  exclusoes          RegistroExclusao[]
  notificacoes       Notificacao[]
  categoriasDespesa  CategoriaDespesa[]
  despesasRecorrente DespesaRecorrente[]
  despesas           Despesa[]
  convites           Convite[]
  eventosPagamento   EventoPagamento[]
}

// Convite para uma oficina nova entrar. O link leva um segredo aleatório; aqui fica só
// o hash dele, então quem lê o banco não consegue montar um link válido.
//
// Uso único: ao virar oficina, `usadoEm` e `oficinaId` são carimbados na mesma
// transação que cria a oficina e o dono dela.
model Convite {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  /// Sugestão para o formulário — quem recebe pode corrigir.
  nomeOficina String?
  /// Para quem foi mandado. Só referência; o cadastro não exige o mesmo e-mail.
  email       String?
  expiraEm    DateTime
  usadoEm     DateTime?
  /// Oficina criada com este convite.
  oficinaId   String?
  criadoPor   String
  createdAt   DateTime  @default(now())

  oficina Oficina? @relation(fields: [oficinaId], references: [id])

  @@index([createdAt])
}

// Evento recebido do gateway de pagamento. O `id` é o do próprio evento: o gateway
// reenvia o mesmo evento até receber 200, e a chave primária é o que impede um
// pagamento de estender o prazo duas vezes. Tabela do sistema, como `Convite`.
model EventoPagamento {
  id        String   @id
  tipo      String
  oficinaId String?
  /// Em centavos, quando o evento traz valor.
  valor     Int?
  payload   Json
  createdAt DateTime @default(now())

  oficina Oficina? @relation(fields: [oficinaId], references: [id], onDelete: SetNull)

  @@index([oficinaId, createdAt])
}

model Cliente {
  id        String   @id @default(cuid())
  oficinaId String   @default(dbgenerated("current_setting('app.oficina_id'::text, true)"))
  oficina   Oficina  @relation(fields: [oficinaId], references: [id])
  nome      String
  telefone  String?
  cpfCnpj   String?
  email     String?
  obs       String?
  apelido   String?
  origem    String? // "INDICACAO" | "GOOGLE" | "INSTAGRAM" | "FACEBOOK" | "FAIXADA" | "OUTRO"
  profissao String?
  telefones String[]
  cep       String?
  endereco  String?
  cidade    String?
  estado    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  veiculos       Veiculo[]
  ordens         OrdemServico[]
  orcamentos     Orcamento[]
  dividasAvulsas DividaAvulsa[]

  // CPF/CNPJ não se repete dentro da oficina — duas oficinas podem atender o mesmo cliente.
  @@unique([oficinaId, cpfCnpj])
  @@index([oficinaId])
}

model Veiculo {
  id               String   @id @default(cuid())
  oficinaId        String   @default(dbgenerated("current_setting('app.oficina_id'::text, true)"))
  oficina          Oficina  @relation(fields: [oficinaId], references: [id])
  clienteId        String
  marca            String
  modelo           String
  ano              Int?
  placa            String?
  cor              String?
  km               Int?
  motorizacao      String?
  valvulas         String? // "8V" | "16V" | "12V" | "20V" | "24V"
  anoFabricacao    Int?
  anoModelo        Int?
  combustivel      String? // "GASOLINA" | "ETANOL" | "FLEX" | "DIESEL" | "ELETRICO" | "HIBRIDO" | "GNV"
  combustivelEmUso String? // para Flex/Híbrido: "GASOLINA" | "ETANOL"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cliente    Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  ordens     OrdemServico[]
  orcamentos Orcamento[]

  @@unique([oficinaId, placa])
  @@index([oficinaId])
  @@index([clienteId])
}

// status: ABERTA | EM_ANDAMENTO | AGUARDANDO_PECA | ENTREGUE | CANCELADA
// A lista canônica (rótulo e cor) vive em src/lib/constants.ts — `OS_STATUS`.
//
// `fechamento` é a data de entrega e só é carimbada na transição para ENTREGUE. É ela
// que define em que semana/mês a OS conta como produção: a abertura não serve, senão um
// carro aberto há 30 dias e entregue hoje contaria no mês errado.
model OrdemServico {
  id               String    @id @default(cuid())
  oficinaId        String    @default(dbgenerated("current_setting('app.oficina_id'::text, true)"))
  oficina          Oficina   @relation(fields: [oficinaId], references: [id])
  numero           Int
  clienteId        String
  veiculoId        String
  status           String    @default("ABERTA")
  descricao        String
  defeitoRelatado  String?
  kmEntrada        Int?
  kmSaida          Int?
  totalPecas       Float     @default(0)
  totalMO          Float     @default(0)
  desconto         Float     @default(0)
  total            Float     @default(0)
  pago             Boolean   @default(false)
  valorPago        Float     @default(0)
  formaPagamento   String?
  obs              String?
  mecanico         String? // nome denormalizado (compat / OS antigas)
  mecanicoId       String?
  nivelCombustivel String? // "CHEIO" | "MEIO" | "VAZIO"
  combustivelEmUso String?
  custoTotalPecas  Float     @default(0)
  lucroReal        Float     @default(0)
  margemPecas      Float     @default(0)
  nps              Int?
  abertura         DateTime  @default(now())
  fechamento       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  cliente     Cliente            @relation(fields: [clienteId], references: [id])
  veiculo     Veiculo            @relation(fields: [veiculoId], references: [id])
  mecanicoRef Mecanico?          @relation(fields: [mecanicoId], references: [id])
  itens       ItemOrdem[]
  pagamentos  PagamentoOS[]
  orcamento   Orcamento?
  fotos       FotoOS[]
  movimentos  MovimentoEstoque[]

  // A numeração é por oficina: cada uma começa na OS nº 1.
  @@unique([oficinaId, numero])
  @@index([oficinaId, status])
  @@index([oficinaId, pago])
  @@index([clienteId])
  @@index([mecanicoId])
}

model Mecanico {
  id            String   @id @default(cuid())
  oficinaId     String   @default(dbgenerated("current_setting('app.oficina_id'::text, true)"))
  oficina       Oficina  @relation(fields: [oficinaId], references: [id])
  nome          String
  telefone      String?
  especialidade String?
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ordens OrdemServico[]
  metas  Meta[]

  @@index([oficinaId])
}

// Meta de lucro real por mecânico, por mês.
model Meta {
  id         String   @id @default(cuid())
  oficinaId  String   @default(dbgenerated("current_setting('app.oficina_id'::text, true)"))
  oficina    Oficina  @relation(fields: [oficinaId], references: [id])
  mecanicoId String
  ano        Int
  mes        Int // 1-12
  valorAlvo  Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  mecanico Mecanico @relation(fields: [mecanicoId], references: [id], onDelete: Cascade)

  @@unique([mecanicoId, ano, mes])
  @@index([oficinaId])
}

// status: PENDENTE | APROVADO | RECUSADO | CONVERTIDO
//
// Um orçamento pode ser rascunho: quando o cliente ainda não está cadastrado,
// clienteId fica nulo e a identificação vive nos campos livres abaixo. O cadastro
// de verdade só é exigido na conversão em OS.
model Orcamento {
  id              String    @id @default(cuid())
  oficinaId       String    @default(dbgenerated("current_setting('app.oficina_id'::text, true)"))
  oficina         Oficina   @relation(fields: [oficinaId], references: [id])
  numero          Int
  clienteId       String?
  veiculoId       String?
  // Dados soltos do rascunho — usados só enquanto não há cliente/veículo cadastrado.
  clienteNome     String?
  clienteTelefone String?
  veiculoDesc     String?
  status          String    @default("PENDENTE")
  descricao       String?
  totalPecas      Float     @default(0)
  totalMO         Float     @default(0)
  desconto        Float     @default(0)
  total           Float     @default(0)
  validade        DateTime?
  obs             String?
  ordemId         String?   @unique // OS gerada na conversão
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  cliente Cliente?        @relation(fields: [clienteId], references: [id])
  veiculo Veiculo?        @relation(fields: [veiculoId], references: [id])
  ordem   OrdemServico?   @relation(fields: [ordemId], references: [id])
  itens   ItemOrcamento[]
  fotos   FotoOS[]

  @@unique([oficinaId, numero])
  @@index([oficinaId, status])
  @@index([clienteId])
}

// tipo: PECA | MAO_DE_OBRA | SERVICO
//
// `produtoId` diz que a peça saiu da prateleira (ver model Produto). O orçamento
// **não** dá baixa: ele é uma proposta, e o que sai do estoque é o que a OS
// consome. O vínculo existe aqui para ser copiado na conversão em OS.
model ItemOrcamento {
  id          String   @id @default(cuid())
  oficinaId   String   @default(dbgenerated("current_setting('app.oficina_id'::text, true)"))
  oficina     Oficina  @relation(fields: [oficinaId], references: [id])
  orcamentoId String
  produtoId   String?
  tipo        String   @default("PECA")
  descricao   String
  quantidade  Float    @default(1)
  valorUnit   Float
  valorTotal  Float
  custoUnit   Float?
  fornecedor  String?
  createdAt   DateTime @default(now())

  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  produto   Produto?  @relation(fields: [produtoId], references: [id], onDelete: SetNull)

  @@index([oficinaId])
  @@index([orcamentoId])
  @@index([produtoId])
}

// tipo: PECA | MAO_DE_OBRA | SERVICO
//
// `produtoId` é o vínculo com o estoque: é ele que faz a peça baixar da prateleira
// ao ser gravada na OS. Descrição, preço e custo continuam sendo cópias, não
// ponteiros — reajustar a tabela do estoque não pode reescrever o que um cliente
// já pagou mês passado.
model ItemOrdem {
  id         String   @id @default(cuid())
  oficinaId  String   @default(dbgenerated("current_setting('app.oficina_id'::text, true)"))
  oficina    Oficina  @relation(fields: [oficinaId], references: [id])
  ordemId    String
  produtoId  String?
  tipo       String   @default("PECA")
  descricao  String
  quantidade Float    @default(1)
  valorUnit  Float
  valorTotal Float
  custoUnit  Float?
  fornecedor String?
  createdAt  DateTime @default(now())

  ordem   OrdemServico @relation(fields: [ordemId], references: [id], onDelete: Cascade)
  produto Produto?     @relation(fields: [produtoId], references: [id], onDelete: SetNull)

  @@index([oficinaId])
  @@index([ordemId])
  @@index([produtoId])
}

// ─── Estoque ─────────────────────────────────────────────────────────────────
//
// O produto é o que está na prateleira: custo, preço de venda e quantidade. Ele
// não substitui o item da OS — a OS continua guardando a própria linha, com o
// preço praticado naquele dia (ver ItemOrdem).
//
// `custoUnit` se chama assim de propósito, e não `custo`: é o mesmo nome que o
// item da OS usa, então `semFinanceiro()` (lib/permissoes) já o apaga para quem
// não pode ver dinheiro, sem precisar de uma segunda lista de campos.
model Produto {
  id            String   @id @default(cuid())
  oficinaId     String   @default(dbgenerated("current_setting('app.oficina_id'::text, true)"))
  oficina       Oficina  @relation(fields: [oficinaId], references: [id])
  nome          String
  /// Código do fabricante/fornecedor. Entra na busca junto com o nome.
  codigo        String?
  /// Nome, código e fornecedor em minúsculo e sem acento. É o campo que a busca
  /// compara, e existe porque o `ILIKE` do Postgres não ignora acento: sem ele,
  /// digitar "agua" na OS não acharia "Água desmineralizada". Mantido pela
  /// aplicação (`textoDeBusca`, lib/estoque) a cada gravação.
  busca         String   @default("")
  unidade       String   @default("UN")
  custoUnit     Float    @default(0)
  valorVenda    Float    @default(0)
  quantidade    Float    @default(0)
  /// Abaixo disto a tela avisa que é hora de repor. Zero desliga o aviso.
  estoqueMinimo Float    @default(0)
  fornecedor    String?
  obs           String?
  /// Desativado some da busca da OS, mas o histórico que o usa continua legível.
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  itensOrdem     ItemOrdem[]
  itensOrcamento ItemOrcamento[]
  movimentos     MovimentoEstoque[]

  @@unique([oficinaId, codigo])
  @@index([oficinaId, ativo, nome])
  /// Índice da busca por trecho do campo de peça da OS. Precisa ser GIN com trigramas
  /// porque o filtro é `contains`, que vira `LIKE '%x%'`: um btree comum só serve para
  /// o que começa com o termo, então o índice acima não ajuda e o banco varre a tabela
  /// inteira a cada letra digitada. Depende da extensão pg_trgm (criada na migração).
  @@index([busca(ops: raw("gin_trgm_ops"))], type: Gin)
}

// tipo: ENTRADA | SAIDA | AJUSTE
//
// Livro-caixa do estoque. Existe porque "tenho 3" sem o "por quê" é um número que
// ninguém consegue conferir: aqui ficam a compra, a baixa de cada OS e o acerto de
// prateleira, cada um com o saldo que deixou.
//
// `quantidade` é a variação com sinal (+ entra, − sai), então a soma dos
// movimentos de um produto é o saldo dele. `ordemNumero` é cópia congelada: a OS
// pode ser excluída depois, e o rastro precisa continuar legível — mesma ideia do
// `usuarioNome` de RegistroExclusao.
model MovimentoEstoque {
  id          String   @id @default(cuid())
  oficinaId   String   @default(dbgenerated("current_setting('app.oficina_id'::text, true)"))
  oficina     Oficina  @relation(fields: [oficinaId], references: [id])
  produtoId   String
  tipo        String
  quantidade  Float
  saldoDepois Float
  custoUnit   Float?
  motivo      String?
  ordemId     String?
  ordemNumero Int?
  usuarioNome String?
  createdAt   DateTime @default(now())

  produto Produto       @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  ordem   OrdemServico? @relation(fields: [ordemId], references: [id], onDelete: SetNull)

  @@index([oficinaId])
  @@index([produtoId, createdAt])
  @@index([ordemId])
}

// formaPagamento: DINHEIRO | PIX | CARTAO_CREDITO | CARTAO_DEBITO | TRANSFERENCIA
model PagamentoOS {
  id             String   @id @default(cuid())
  oficinaId      String   @default(dbgenerated("current_setting('app.oficina_id'::text, true)"))
  oficina        Oficina  @relation(fields: [oficinaId], references: [id])
  ordemId        String
  valor          Float
  formaPagamento String   @default("DINHEIRO")
  data           DateTime @default(now())
  obs            String?
  createdAt      DateTime @default(now())

  ordem OrdemServico @relation(fields: [ordemId], references: [id], onDelete: Cascade)

  @@index([oficinaId])
  @@index([ordemId])
}

// Uma dívida avulsa pode não ter cliente cadastrado: clienteId fica nulo e
// devedorNome guarda o nome digitado na hora — mesma ideia do rascunho do
// orçamento (ver Orcamento.clienteNome). Quem quiser cobrar por WhatsApp depois
// precisa cadastrar o cliente; aqui só se registra a dívida em si.
model DividaAvulsa {
  id          Int      @id @default(autoincrement())
  oficinaId   String   @default(dbgenerated("current_setting('app.oficina_id'::text, true)"))
  oficina     Oficina  @relation(fields: [oficinaId], references: [id])
  clienteId   String?
  devedorNome String?
  descricao   String
  valor       Float
  valorPago   Float    @default(0)
  pago        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cliente    Cliente?          @relation(fields: [clienteId], references: [id])
  pagamentos PagamentoDivida[]

  @@index([oficinaId])
  @@index([clienteId])
}

model PagamentoDivida {
  id             Int      @id @default(autoincrement())
  oficinaId      String   @default(dbgenerated("current_setting('app.oficina_id'::text, true)"))
  oficina        Oficina  @relation(fields: [oficinaId], references: [id])
  dividaId       Int
  valor          Float
  formaPagamento String
  obs            String?
  data           DateTime @default(now())

  divida DividaAvulsa @relation(fields: [dividaId], references: [id])

  @@index([oficinaId])
  @@index([dividaId])
}

// Foto anexada a um documento — o arquivo fica no Supabase Storage, aqui só a referência.
//
// A foto pode nascer no orçamento (o defeito que o cliente trouxe, fotografado antes
// de haver OS) ou direto na OS. Na conversão ela ganha também o `ordemId`, sem perder
// o `orcamentoId`: a mesma foto passa a aparecer nos dois documentos, e o orçamento
// impresso continua igual ao que o cliente aprovou.
model FotoOS {
  id           String   @id @default(cuid())
  oficinaId    String   @default(dbgenerated("current_setting('app.oficina_id'::text, true)"))
  oficina      Oficina  @relation(fields: [oficinaId], references: [id])
  ordemId      String?
  orcamentoId  String?
  path         String // caminho do arquivo no bucket (usado para excluir)
  url          String // URL pública da imagem
  legenda      String?
  tipo         String   @default("SERVICO") // ENTRADA | SERVICO | SAIDA
  tamanhoBytes Int      @default(0) // tamanho do arquivo, para o cálculo de uso do plano
  createdAt    DateTime @default(now())

  ordem     OrdemServico? @relation(fields: [ordemId], references: [id], onDelete: Cascade)
  orcamento Orcamento?    @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  @@index([oficinaId])
  @@index([ordemId, tipo])
  @@index([orcamentoId])
}

// Contador da numeração (OS, orçamento) — uma linha por oficina e por documento.
model Sequencia {
  oficinaId String @default(dbgenerated("current_setting('app.oficina_id'::text, true)"))
  id        String
  ultimo    Int    @default(0)

  oficina Oficina @relation(fields: [oficinaId], references: [id])

  @@id([oficinaId, id])
}

// papel: ADMIN | OPERADOR
//
// ADMIN é o dono: vê dinheiro (lucro, margem, custo, caixa, contas) e configura o
// sistema — sempre, os dois campos abaixo não se aplicam a ele. OPERADOR toca a
// operação — clientes, OS, orçamentos, fotos — e por padrão nem financeiro nem
// exclusão. `podeFinanceiro`/`podeExcluir` dão o ajuste fino por pessoa, por cima do
// papel: liberam um operador específico sem torná-lo dono. A separação não é só de
// tela: as rotas de API filtram os campos financeiros antes de responder, senão
// bastaria abrir o DevTools.
model Usuario {
  id                   String    @id @default(cuid())
  oficinaId            String    @default(dbgenerated("current_setting('app.oficina_id'::text, true)"))
  oficina              Oficina   @relation(fields: [oficinaId], references: [id])
  nome                 String
  /// Único no sistema inteiro, e não por oficina: é o e-mail que diz, no login, de
  /// qual oficina a pessoa é.
  email                String    @unique
  senhaHash            String
  papel                String    @default("OPERADOR")
  podeFinanceiro       Boolean   @default(false)
  podeExcluir          Boolean   @default(false)
  ativo                Boolean   @default(true)
  ultimoAcesso         DateTime?
  /// Dono da plataforma: gera convites e vê a lista de oficinas. Não abre os dados de
  /// outras oficinas — isso não existe para ninguém.
  administraPlataforma Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  sessoes   Sessao[]
  exclusoes RegistroExclusao[]

  @@index([oficinaId])
}

// Backlog de exclusões — rastro de quem apagou o quê, já que a exclusão em si some com
// o registro original. `usuarioNome` é uma cópia congelada do nome: se a pessoa for
// removida depois, o rastro continua legível (`usuarioId` fica nulo, mas o nome fica).
model RegistroExclusao {
  id          String   @id @default(cuid())
  oficinaId   String   @default(dbgenerated("current_setting('app.oficina_id'::text, true)"))
  oficina     Oficina  @relation(fields: [oficinaId], references: [id])
  tipo        String
  descricao   String
  usuarioId   String?
  usuarioNome String
  createdAt   DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([oficinaId, createdAt])
}

// Sessão de login. Guardar no banco (em vez de só assinar um token) é o que permite
// desligar um acesso na hora: excluir a linha derruba a sessão no próximo carregamento,
// sem esperar o cookie expirar.
//
// O `id` é o próprio segredo (32 bytes aleatórios), então nunca é logado nem exibido.
model Sessao {
  id        String   @id
  usuarioId String
  expiraEm  DateTime
  criadaEm  DateTime @default(now())
  userAgent String?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEm])
}

// Configurações da oficina — linha única, id fixo "default".
//
// Tudo que hoje estaria chumbado no código (nome, CNPJ, telefone, logo, cores) mora
// aqui, para que a mesma base de código sirva qualquer oficina: é este registro que
// alimenta o cabeçalho da OS/orçamento impressos, o menu lateral e o tema do sistema.
//
// É uma linha só de propósito. Quando o produto virar multi-oficina de verdade, esta
// tabela é a semente do registro de tenant — basta trocar o id fixo pela chave da
// oficina e passar a filtrar as demais tabelas por ela.
model Configuracao {
  oficinaId String  @id @default(dbgenerated("current_setting('app.oficina_id'::text, true)"))
  oficina   Oficina @relation(fields: [oficinaId], references: [id])

  // Identidade — sai no topo dos documentos e no menu
  nome      String  @default("Minha Oficina")
  nomeCurto String? // versão enxuta para o menu lateral
  cnpj      String?
  telefone  String?
  whatsapp  String?
  email     String?
  site      String?

  // Endereço
  cep      String?
  endereco String?
  cidade   String?
  estado   String?

  // Marca
  logoUrl  String?
  logoPath String? // caminho no Storage — usado para excluir a logo antiga

  // Tema: as cores base do sistema, em hex (#rrggbb). Oficina nova nasce nas cores
  // do boxOS (amarelo + grafite) até escolher as dela.
  corPrimaria String @default("#f2a900")
  corMenu     String @default("#1e2329")

  // Documentos (OS e orçamento impressos / PDF)
  rodapeDocumento       String?
  mensagemDocumento     String? // garantia, termos, recado ao cliente
  mostrarAssinatura     Boolean @default(true)
  validadeOrcamentoDias Int     @default(7)

  // Reserva de lucro: quanto do lucro (MO + lucro em peça) sugerir guardar. Só indicação — não move dinheiro.
  reservaLucroAtiva      Boolean @default(false)
  reservaLucroPercentual Float   @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Notificação persistente, para lembrar de algo que sumiria do toast em poucos
// segundos (Avisos.tsx) — aviso de armazenamento, futuros alertas de vencimento etc.
//
// Linha global, sem `usuarioId`: como `Configuracao`, é uma tabela pequena de uma
// oficina só, e não vale a complexidade de leitura por usuário para 1-3 pessoas de
// acesso. `publico` decide quem vê — dado financeiro sempre fica em "ADMIN".
model Notificacao {
  id        String    @id @default(cuid())
  oficinaId String    @default(dbgenerated("current_setting('app.oficina_id'::text, true)"))
  oficina   Oficina   @relation(fields: [oficinaId], references: [id])
  tipo      String // "ARMAZENAMENTO" | "SISTEMA" | ...
  titulo    String
  mensagem  String
  link      String? // ex.: "/configuracoes"
  lida      Boolean   @default(false)
  lidaEm    DateTime?
  publico   String    @default("ADMIN") // "ADMIN" | "TODOS"
  createdAt DateTime  @default(now())

  @@index([oficinaId, lida, createdAt])
  @@index([oficinaId, publico, lida])
}

// ─── Controle de gastos ──────────────────────────────────────────────────────
//
// Três tabelas porque são três coisas diferentes, e misturá-las foi o que travou a
// versão anterior:
//
//   CategoriaDespesa  — como a oficina organiza os gastos. Editável pelo dono; antes
//                       era um enum no código e ninguém podia criar "Contador".
//   DespesaRecorrente — a REGRA ("aluguel, todo dia 5, R$ 3.000"). É daqui que sai o
//                       custo operacional: um número que existe mesmo com nada pago.
//   Despesa           — o LANÇAMENTO de um mês. Nasce da regra ou é avulso.
//
// Antes só existia o lançamento: a próxima ocorrência do aluguel só era criada quando
// a anterior fosse marcada como paga, então o mês nunca aparecia inteiro e não havia
// como perguntar "quanto custa manter a oficina aberta".

model CategoriaDespesa {
  id        String   @id @default(cuid())
  oficinaId String   @default(dbgenerated("current_setting('app.oficina_id'::text, true)"))
  oficina   Oficina  @relation(fields: [oficinaId], references: [id])
  nome      String
  /// Cor do chip na tela e da barra no gráfico por categoria.
  cor       String   @default("#71717a")
  ordem     Int      @default(0)
  /// Desativada some dos formulários, mas o histórico que a usa continua legível.
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  despesas    Despesa[]
  recorrentes DespesaRecorrente[]

  @@unique([oficinaId, nome])
  @@index([oficinaId, ativa, ordem])
}

// periodicidade: MENSAL | BIMESTRAL | TRIMESTRAL | SEMESTRAL | ANUAL
model DespesaRecorrente {
  id            String    @id @default(cuid())
  oficinaId     String    @default(dbgenerated("current_setting('app.oficina_id'::text, true)"))
  oficina       Oficina   @relation(fields: [oficinaId], references: [id])
  categoriaId   String
  descricao     String
  /// Valor previsto. O lançamento do mês pode ser pago por outro valor (energia).
  valor         Float
  fornecedor    String?
  /// 1–31. Cai no último dia do mês quando o mês é mais curto.
  diaVencimento Int
  periodicidade String    @default("MENSAL")
  /// Competência (1º dia do mês) em que a regra passa a valer.
  inicio        DateTime
  /// Competência do último mês, ou null enquanto a conta não tiver fim previsto.
  fim           DateTime?
  ativa         Boolean   @default(true)
  observacao    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  categoria   CategoriaDespesa @relation(fields: [categoriaId], references: [id])
  lancamentos Despesa[]

  @@index([oficinaId, ativa])
  @@index([categoriaId])
}

model Despesa {
  id             String    @id @default(cuid())
  oficinaId      String    @default(dbgenerated("current_setting('app.oficina_id'::text, true)"))
  oficina        Oficina   @relation(fields: [oficinaId], references: [id])
  categoriaId    String
  /// Regra que gerou o lançamento; null quando é um gasto avulso do mês.
  recorrenteId   String?
  /// Mês a que o gasto pertence, sempre o 1º dia (meia-noite de Brasília).
  competencia    DateTime
  descricao      String
  /// Previsto.
  valor          Float
  /// Realizado. Null enquanto não foi pago; pode diferir do previsto.
  valorPago      Float?
  fornecedor     String?
  vencimento     DateTime
  pago           Boolean   @default(false)
  pagoEm         DateTime?
  formaPagamento String?
  observacao     String?
  /// "Não teve este mês". A linha fica de lápide: apagá-la de vez faria a regra
  /// gerar o lançamento de novo na próxima abertura do mês. Some das somas.
  cancelado      Boolean   @default(false)
  /// Compra dividida: as parcelas nascem juntas e compartilham este id, que é o que
  /// deixa excluir "esta e as próximas" de uma vez. Null em gasto não parcelado.
  parcelamentoId String?
  /// Posição desta parcela (1, 2, 3…) e o total delas — o "2/3" da tela.
  parcela        Int?
  parcelas       Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  categoria  CategoriaDespesa   @relation(fields: [categoriaId], references: [id])
  recorrente DespesaRecorrente? @relation(fields: [recorrenteId], references: [id], onDelete: SetNull)

  /// Uma regra só pode ter um lançamento por mês — é o que torna a geração
  /// sob demanda idempotente sem precisar de trava na aplicação.
  @@unique([recorrenteId, competencia])
  @@index([oficinaId, competencia])
  @@index([oficinaId, pago])
  @@index([oficinaId, vencimento])
  @@index([categoriaId])
  @@index([parcelamentoId])
}
