generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Cliente {
  id        String   @id @default(cuid())
  nome      String
  telefone  String?
  cpfCnpj   String?  @unique
  email     String?
  obs       String?
  apelido   String?
  origem    String?   // "INDICACAO" | "GOOGLE" | "INSTAGRAM" | "FACEBOOK" | "FAIXADA" | "OUTRO"
  profissao String?
  telefones String[]
  cep       String?
  endereco  String?
  cidade    String?
  estado    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  veiculos       Veiculo[]
  ordens         OrdemServico[]
  orcamentos     Orcamento[]
  dividasAvulsas DividaAvulsa[]
}

model Veiculo {
  id           String   @id @default(cuid())
  clienteId    String
  marca        String
  modelo       String
  ano          Int?
  placa        String?  @unique
  cor          String?
  km           Int?
  motorizacao  String?
  valvulas     String?   // "8V" | "16V" | "12V" | "20V" | "24V"
  anoFabricacao Int?
  anoModelo    Int?
  combustivel  String?   // "GASOLINA" | "ETANOL" | "FLEX" | "DIESEL" | "ELETRICO" | "HIBRIDO" | "GNV"
  combustivelEmUso String? // para Flex/Híbrido: "GASOLINA" | "ETANOL"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cliente    Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  ordens     OrdemServico[]
  orcamentos Orcamento[]
}

// status: ABERTA | EM_ANDAMENTO | AGUARDANDO_PECA | PRONTA | FECHADA | ENTREGUE | CANCELADA
model OrdemServico {
  id               String    @id @default(cuid())
  numero           Int       @unique
  clienteId        String
  veiculoId        String
  status           String    @default("ABERTA")
  descricao        String
  defeitoRelatado  String?
  kmEntrada        Int?
  kmSaida          Int?
  totalPecas       Float     @default(0)
  totalMO          Float     @default(0)
  desconto         Float     @default(0)
  total            Float     @default(0)
  pago             Boolean   @default(false)
  valorPago        Float     @default(0)
  formaPagamento   String?
  obs              String?
  mecanico         String?   // nome denormalizado (compat / OS antigas)
  mecanicoId       String?
  nivelCombustivel String?   // "CHEIO" | "MEIO" | "VAZIO"
  combustivelEmUso String?
  custoTotalPecas  Float     @default(0)
  lucroReal        Float     @default(0)
  margemPecas      Float     @default(0)
  nps              Int?
  abertura         DateTime  @default(now())
  fechamento       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  cliente     Cliente       @relation(fields: [clienteId], references: [id])
  veiculo     Veiculo       @relation(fields: [veiculoId], references: [id])
  mecanicoRef Mecanico?     @relation(fields: [mecanicoId], references: [id])
  itens       ItemOrdem[]
  pagamentos  PagamentoOS[]
  orcamento   Orcamento?
  fotos       FotoOS[]

  @@index([status])
  @@index([pago])
  @@index([clienteId])
  @@index([mecanicoId])
}

model Mecanico {
  id            String   @id @default(cuid())
  nome          String
  telefone      String?
  especialidade String?
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ordens OrdemServico[]
  metas  Meta[]
}

// Meta de faturamento total por mecânico, por mês.
model Meta {
  id         String   @id @default(cuid())
  mecanicoId String
  ano        Int
  mes        Int      // 1-12
  valorAlvo  Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  mecanico Mecanico @relation(fields: [mecanicoId], references: [id], onDelete: Cascade)

  @@unique([mecanicoId, ano, mes])
}

// status: PENDENTE | APROVADO | RECUSADO | CONVERTIDO
model Orcamento {
  id         String    @id @default(cuid())
  numero     Int       @unique
  clienteId  String
  veiculoId  String?
  status     String    @default("PENDENTE")
  descricao  String
  totalPecas Float     @default(0)
  totalMO    Float     @default(0)
  desconto   Float     @default(0)
  total      Float     @default(0)
  validade   DateTime?
  obs        String?
  ordemId    String?   @unique // OS gerada na conversão
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  cliente Cliente         @relation(fields: [clienteId], references: [id])
  veiculo Veiculo?        @relation(fields: [veiculoId], references: [id])
  ordem   OrdemServico?   @relation(fields: [ordemId], references: [id])
  itens   ItemOrcamento[]

  @@index([status])
  @@index([clienteId])
}

// tipo: PECA | MAO_DE_OBRA | SERVICO
model ItemOrcamento {
  id          String   @id @default(cuid())
  orcamentoId String
  tipo        String   @default("PECA")
  descricao   String
  quantidade  Float    @default(1)
  valorUnit   Float
  valorTotal  Float
  custoUnit   Float?
  fornecedor  String?
  createdAt   DateTime @default(now())

  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
}

// tipo: PECA | MAO_DE_OBRA | SERVICO
model ItemOrdem {
  id         String   @id @default(cuid())
  ordemId    String
  tipo       String   @default("PECA")
  descricao  String
  quantidade Float    @default(1)
  valorUnit  Float
  valorTotal Float
  custoUnit  Float?
  fornecedor String?
  createdAt  DateTime @default(now())

  ordem OrdemServico @relation(fields: [ordemId], references: [id], onDelete: Cascade)
}

// formaPagamento: DINHEIRO | PIX | CARTAO_CREDITO | CARTAO_DEBITO | TRANSFERENCIA
model PagamentoOS {
  id             String   @id @default(cuid())
  ordemId        String
  valor          Float
  formaPagamento String   @default("DINHEIRO")
  data           DateTime @default(now())
  obs            String?
  createdAt      DateTime @default(now())

  ordem OrdemServico @relation(fields: [ordemId], references: [id], onDelete: Cascade)

  @@index([ordemId])
}

model DividaAvulsa {
  id        Int      @id @default(autoincrement())
  clienteId String
  descricao String
  valor     Float
  valorPago Float    @default(0)
  pago      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cliente    Cliente          @relation(fields: [clienteId], references: [id])
  pagamentos PagamentoDivida[]
}

model PagamentoDivida {
  id             Int          @id @default(autoincrement())
  dividaId       Int
  valor          Float
  formaPagamento String
  obs            String?
  data           DateTime     @default(now())

  divida DividaAvulsa @relation(fields: [dividaId], references: [id])
}

// Foto anexada à OS — o arquivo fica no Supabase Storage, aqui só a referência.
model FotoOS {
  id        String   @id @default(cuid())
  ordemId   String
  path      String   // caminho do arquivo no bucket (usado para excluir)
  url       String   // URL pública da imagem
  legenda   String?
  tipo      String   @default("SERVICO") // ENTRADA | SERVICO | SAIDA
  createdAt DateTime @default(now())

  ordem OrdemServico @relation(fields: [ordemId], references: [id], onDelete: Cascade)

  @@index([ordemId, tipo])
}

model Sequencia {
  id     String @id
  ultimo Int    @default(0)
}