# ── Local (docker compose up -d) ──────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/manager_lite"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/manager_lite"

# ── Supabase (produção / Railway) ─────────────────────────────
# DATABASE_URL = Transaction pooler (porta 6543) + ?pgbouncer=true
# DIRECT_URL   = Direct connection (porta 5432) — usado pelas migrations
#
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ── Autenticação ──────────────────────────────────────────────
# Chave que assina o cookie de sessão. OBRIGATÓRIA: sem ela ninguém consegue entrar.
# Mínimo de 32 caracteres. Gere uma com:  openssl rand -base64 48
# Trocar a chave invalida todas as sessões abertas (todo mundo faz login de novo).
AUTH_SECRET=""

# OPCIONAL, mas recomendado no primeiro deploy: código exigido na tela de primeiro
# acesso. Sem ele, entre subir o site e cadastrar o dono existe uma janela em que
# qualquer um que abrir o endereço pode se cadastrar como dono. Com ele, só quem vê
# as variáveis do servidor consegue. Pode remover depois do dono criado.
SETUP_TOKEN=""

# ── Freio de requisições ──────────────────────────────────────
# Quantos proxies confiáveis existem na frente do app. No Railway é 1 (o proxy de
# borda dele), que é o padrão — não precisa definir. Só mexa se entrar outra camada
# na frente, como Cloudflare: aí vira 2. Errar este número para mais faz o freio ler
# um IP que o próprio visitante pode forjar; para menos, joga todo mundo no mesmo
# balde e o site trava para os usuários de verdade.
# PROXIES_CONFIAVEIS="1"

# ── Fotos da OS (Supabase Storage) ────────────────────────────
# Painel do Supabase → Project Settings → API
# SUPABASE_URL             = "Project URL"
# SUPABASE_SERVICE_ROLE_KEY = chave "service_role" (secreta — nunca expor no front)
# O bucket "os-fotos" é criado automaticamente no primeiro upload.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Pagamento da assinatura (Asaas) ───────────────────────────
# Sem as três, a tela de assinatura mostra "fale com a gente no WhatsApp".
# ASAAS_API_KEY: painel do Asaas → Integrações → Chaves de API. A chave diz o ambiente
#   sozinha: $aact_hmlg_… é sandbox (testes), $aact_prod_… é produção.
#   Neste arquivo, escreva \$ no começo (o Next lê $ como variável); no Railway, não.
# ASAAS_WEBHOOK_TOKEN: uma senha inventada por você, a mesma cadastrada no webhook do
#   painel (Integrações → Webhooks), com a URL https://SEU-SITE/api/webhooks/asaas.
# PRECO_MENSAL_CENTAVOS: valor do mês em centavos (ex.: 9990 = R$ 99,90).
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""
PRECO_MENSAL_CENTAVOS=""
